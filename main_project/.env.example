# ---------- LLM providers (read by LiteLLM) ----------
GEMINI_API_KEY=
GROQ_API_KEY=
PRIMARY_MODEL=gemini/gemini-3.5-flash
FALLBACK_MODEL_1=gemini/gemini-3.1-flash-lite
FALLBACK_MODEL_2=groq/openai/gpt-oss-120b
FALLBACK_MODEL_3=groq/openai/gpt-oss-20b
FALLBACK_MODEL_4=groq/qwen/qwen3.8-27b
LLM_MAX_TOKENS=4096

# ---------- Observability (optional) ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- Auth ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=1440

# ---------- Frontend / CORS ----------
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- PostgreSQL (employee source of truth) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=company_db
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/company_db
PG_POOL_MAXCONN=10
PG_STATEMENT_TIMEOUT_MS=15000
PG_LARGE_WRITE_ROW_THRESHOLD=10

# ---------- Audit log cleanup ----------
AUDIT_RETENTION_DAYS=180
AUDIT_CLEANER_USER=
AUDIT_CLEANER_PASSWORD=

# ---------- MongoDB (users + chat history) ----------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=org_assistant

# ---------- Neo4j (org hierarchy) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=